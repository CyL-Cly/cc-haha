#!/bin/sh
# Packaging bootstrap only. Every CLI, TUI and server action runs in Go.
set -eu

if [ -n "${CC_HAHA_GO_BINARY:-}" ]; then
  case "$CC_HAHA_GO_BINARY" in
    /*) binary=$CC_HAHA_GO_BINARY ;;
    *) echo 'claude-haha: CC_HAHA_GO_BINARY must be an absolute path' >&2; exit 1 ;;
  esac
else
  launcher=$0
  while [ -L "$launcher" ]; do
    directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
    target=$(readlink "$launcher")
    case "$target" in
      /*) launcher=$target ;;
      *) launcher=$directory/$target ;;
    esac
  done
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  case "$(uname -s)" in
    Darwin) platform=darwin ;;
    Linux) platform=linux ;;
    *) echo 'claude-haha: use the native Windows executable or npm launcher on this platform' >&2; exit 1 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) architecture=arm64 ;;
    x86_64|amd64) architecture=amd64 ;;
    *) echo 'claude-haha: unsupported CPU architecture' >&2; exit 1 ;;
  esac
  binary=$directory/native/claude-haha-$platform-$architecture
fi

if [ ! -f "$binary" ] || [ ! -x "$binary" ]; then
  echo "claude-haha: Go executable is missing or not executable: $binary" >&2
  echo 'Build it with bun run build:cli, or install the native executable with bun run install:cli -- --prefix /absolute/path.' >&2
  exit 1
fi
CALLER_DIR=${CALLER_DIR:-"$PWD"}
export CALLER_DIR
exec "$binary" "$@"
